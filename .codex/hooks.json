{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/static-check.sh\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/static-check.sh\" stop",
            "timeout": 210,
            "statusMessage": "Checking changed project source files"
          }
        ]
      }
    ]
  }
}
